set circuit1 [readnet spice /foss/designs/approx_cla/runs/RUN_2026-11-21_08-29-42/68-magic-spiceextraction/approx_cla.spice]
set circuit2 [readnet verilog /dev/null]
puts "Reading SPICE netlist file '/foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice'..."
readnet spice /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice $circuit2
puts "Reading SPICE netlist file '/foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spice'..."
readnet spice /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spice $circuit2
puts "Reading Verilog netlist file '/foss/designs/approx_cla/runs/RUN_2026-11-21_08-29-42/52-openroad-fillinsertion/approx_cla.pnl.v'..."
readnet verilog /foss/designs/approx_cla/runs/RUN_2026-11-21_08-29-42/52-openroad-fillinsertion/approx_cla.pnl.v $circuit2
lvs "$circuit1 approx_cla" "$circuit2 approx_cla" /usr/local/lib/python3.12/dist-packages/librelane/scripts/netgen/setup.tcl /foss/designs/approx_cla/runs/RUN_2026-11-21_08-29-42/70-netgen-lvs/reports/lvs.netgen.rpt -blackbox -json
